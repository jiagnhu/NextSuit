NODE_ENV=development
PORT=18640
API_PREFIX=/api/v1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextsuit?schema=public"
JWT_SECRET="change_this_jwt_secret"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="nextsuit_session"
CORS_ORIGIN="http://localhost:18631,http://localhost:18632,http://localhost:18633"
# Optional. In production, set your public domain so uploaded image URLs are externally reachable.
# PUBLIC_BASE_URL="https://studio.tangyikai.top"
# If your whole suite is under a sub path like /nextsuit, set this once.
PUBLIC_BASE_PATH=""
DEFAULT_ORG_SLUG="nextsuit-demo"
ADMIN_EMAIL="admin@nextsuit.dev"
ADMIN_PASSWORD="Admin123!"
VIEWER_EMAIL="visitor@nextsuit.dev"
VIEWER_PASSWORD="Visitor123!"

# Blog link base used in weekly digest emails.
BLOG_BASE_URL="http://localhost:18633"

# Resend email service
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_REPLY_TO=""

# Weekly digest scheduler (run inside API process)
WEEKLY_DIGEST_ENABLED="false"
WEEKLY_DIGEST_SEND_HOUR="9"
WEEKLY_DIGEST_TIMEZONE="Asia/Shanghai"
WEEKLY_DIGEST_TEST_EMAIL=""

# Production single-subdomain example:
# CORS_ORIGIN="https://studio.tangyikai.top"
# PUBLIC_BASE_URL="https://studio.tangyikai.top"
# PUBLIC_BASE_PATH="/nextsuit"
